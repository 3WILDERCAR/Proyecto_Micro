	(text "C11/C14: desacople de U5, junto a los pines 9 (VDD) y 10 (VSS).\nDirección: A2 A1 A0 = 000 -> 0x20 (0100 A2 A1 A0, DS20001952E).\nLED encendido = GPAx en 0 (U5 absorbe la corriente).\nSwitch hacia +3V3_IO = 1, hacia GND = 0. R2-R9 (1k) limitan a 3.3 mA\nsi un pin de GPB se configura como salida por error."
		(exclude_from_sim no)
		(at 175.26 150.5 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "22e9652d-0833-42c4-bdbe-fd22293a3617")
	)
